# ─── Agent brain (LLM) ─── OpenAI-compatible. Default: Groq (free).
LLM_API_KEY=gsk_your_groq_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# ─── Embeddings ─── "local" (fastembed, no key) or "openai" (Gemini/OpenAI compatible)
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-small-en-v1.5
VECTOR_DIM=384
# If EMBED_PROVIDER=openai, also set:
# EMBED_API_KEY=...
# EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   # Gemini OpenAI-compat
# EMBED_MODEL=text-embedding-004
# VECTOR_DIM=768

# ─── Vector + metadata DB (Supabase Postgres + pgvector) ───
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# ─── Web search tool ───
TAVILY_API_KEY=tvly-your_key_here

# ─── Observability (Langfuse Cloud, free tier) ───
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Demo hardening ───
SESSION_TTL_SECONDS=3600
MAX_UPLOAD_MB=10
MAX_PAGES=120
RATE_LIMIT_PER_MIN=12
GLOBAL_DAILY_CAP=500
MAX_TOOL_ROUNDS=2
RELEVANCE_DISTANCE_THRESHOLD=0.5
